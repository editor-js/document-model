{
  "name": "@editorjs/editorjs",
  "version": "0.0.0",
  "packageManager": "yarn@4.0.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "yarn build:dependencies && yarn clear && tsc --build tsconfig.build.json",
    "build:dependencies": "yarn workspaces foreach -Rpt --from $npm_package_name --exclude $npm_package_name run build",
    "build:declaration": "yarn build --emitDeclarationOnly",
    "lint": "eslint ./src ./e2e playwright.config.ts playwright.voiceover.config.ts",
    "lint:ci": "yarn lint --max-warnings 0",
    "lint:fix": "yarn lint --fix",
    "test": "node --experimental-vm-modules $(yarn bin jest)",
    "test:coverage": "yarn test --coverage=true",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:voiceover": "playwright test --config playwright.voiceover.config.ts",
    "clear": "rm -rf dist && rm -f tsconfig.build.tsbuildinfo && rm -f tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@guidepup/guidepup": "^0.29.2",
    "@guidepup/playwright": "^0.18.0",
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.62.0",
    "@types/eslint": "^9.6.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.10.2",
    "babel-jest": "^29.7.0",
    "eslint": "^9.24.0",
    "eslint-config-codex": "^2.0.3",
    "eslint-plugin-import": "^2.31.0",
    "jest": "^29.7.0",
    "playwright-core": "^1.62.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@editorjs/bold": "workspace:^",
    "@editorjs/clipboard-plugin": "workspace:^",
    "@editorjs/collaboration-manager": "workspace:^",
    "@editorjs/core": "workspace:^",
    "@editorjs/dom-adapters": "workspace:^",
    "@editorjs/inline-link": "workspace:^",
    "@editorjs/italic": "workspace:^",
    "@editorjs/paragraph": "workspace:^",
    "@editorjs/sdk": "workspace:^",
    "@editorjs/shortcuts-plugin": "workspace:^",
    "@editorjs/ui": "workspace:^"
  }
}
